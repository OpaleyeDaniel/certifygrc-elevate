# ─── Copy to .env or .env.local (never commit real secrets) ───────────────
# Required for contact form, consultation booking, and partner application emails.

# Local dev only: skip real email sends (forms still return success). Requires NODE_ENV=development.
# MAIL_SKIP_SEND=true

# Preferred on Vercel: Resend HTTPS API (no SMTP). If set, SMTP_* is not required.
# Get a key at https://resend.com — sender domain must be verified in Resend.
# RESEND_API_KEY=re_xxxxxxxx

# SMTP (transactional mail — use if not using Resend: Gmail app password, SendGrid SMTP, Mailgun, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Use true for port 465 (implicit TLS); usually false/omit for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional: set true to log SMTP wire debug in server logs (dev/troubleshooting only)
SMTP_DEBUG=false

# Outbound sender — must be a verified @certifygrc.ca address in Resend (production).
# Defaults to info@certifygrc.ca when unset. Local SMTP uses SMTP_USER as From instead.
CONTACT_EMAIL_FROM=info@certifygrc.ca
# Internal inbox for form submissions and quiz leads (team notifications).
# Code always routes internal notifications to mercy@certifygrc.ca.
CONTACT_EMAIL_TO=mercy@certifygrc.ca

# Public site URL for absolute links in emails (waitlist CTA to /early-access, etc.). Include https://
# Production: https://certifygrc.com (recommended — ensures emails link to your custom domain)
SITE_URL=https://certifygrc.com

# ─── Sanity CMS (Blog) ─────────────────────────────────────────────────────
# Project ID from https://sanity.io/manage → your project. Already set below.
VITE_SANITY_PROJECT_ID=729gr7n1
VITE_SANITY_DATASET=production
# Optional: force local seed blog (15 articles) instead of Sanity — useful for design review
# Set false in production once Sanity is fully populated with live content
VITE_BLOG_USE_SEED=true

# ─── Landing hero · Supademo (optional overrides) ───────────────────────────
# Defaults are baked in (see src/constants/supademo.ts). Set these only to override.
# VITE_SUPADEMO_EMBED_URL=https://app.supademo.com/embed/cmng2dd444qj0u98h4uud0lia?utm_source=link
# VITE_SUPADEMO_OPEN_URL=https://app.supademo.com/demo/cmng2dd444qj0u98h4uud0lia?utm_source=link

# ─── API / CORS (only if frontend and /api are on different origins) ───────
# Comma-separated list of allowed browser origins for JSON POSTs (scheme + host, no path).
# Example: https://certifygrc.com,https://www.certifygrc.com
# Leave unset for default same-origin deployments (Vercel app serves both SPA + /api).
# API_ALLOWED_ORIGINS=

# Frontend: when the marketing site is hosted separately, set this to the deployment that serves /api/*
# (no trailing slash). Example: https://your-project.vercel.app
# VITE_API_BASE_URL=

# ─── Vercel / production ───────────────────────────────────────────────────
# Set the same variables in: Vercel Dashboard → Project → Settings → Environment Variables
# (Production + Preview if you want forms to work on preview deployments.)
